layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    // senzu
    tab name="senzu" focus=true cwd="$HOME/src/iamnande/senzu" {
        // just a shell - claude at boot runs gh, and gh asks the keyring before the unlock
        pane name="bean"
    }
}
