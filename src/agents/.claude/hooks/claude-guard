#!/usr/bin/python3
"""claude-guard: PreToolUse hook for Bash and Monitor commands.

exits 2, a hard block that wins over allow rules, for:
- branch deletes, local or remote
- every push, and rewiring where remotes point
- publishing, git worktree remove --force
- sudo and friends
- every commit, except one in a state repo (rfc 0002 §2.7)
- the other git commands that make commits (cherry-pick, revert, am, rebase, a
  merge or pull that isn't --ff-only, and friends), everywhere
- in a state repo, any git command that isn't on its list of reads

a state repo is listed in claude-guard.json, next to this file. a commit there
takes only `git commit -m <msg> -- <file>...`, every file under one of its agent
paths, and the repo's own git config can't set who commits, how it's signed or
which hooks run. a missing config means no state repos; a broken one blocks
every commit.

anything it can't parse or resolve is blocked too (fail closed). these are
text checks, not a sandbox: a script file's contents are invisible here.
"""
import json
import os
import re
import shlex
import subprocess
import sys

HOME = os.path.expanduser("~")
CONFIG = os.path.join(HOME, ".claude", "hooks", "claude-guard.json")
MAX_DEPTH = 8

URL_KEY = re.compile(r"^(?:remote\..+\.(?:url|pushurl)|url\..+\.(?:insteadof|pushinsteadof)|remote\.pushdefault|branch\..+\.(?:remote|pushremote))$", re.I)
ASSIGN = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")
HEREDOC = re.compile(r"<<(-?)\s*([\"']?)([A-Za-z_][\w-]*)\2")
SHELL_FED = re.compile(r"(?:^|[\s;&|(])(?:\S*/)?(?:bash|sh|zsh|fish|dash|ksh|eval|source)(?=\s|$)")
PUNCT = set("();<>|&\n")
# env that changes who commits, how, or into which repo. only setting one
# counts, so a commit message can still name it.
_GIT_ENV = r"GIT_(?:AUTHOR_\w+|COMMITTER_\w+|CONFIG\w*|DIR|WORK_TREE|INDEX_FILE|OBJECT_DIRECTORY|ALTERNATE_OBJECT_DIRECTORIES|NAMESPACE|EXEC_PATH)"
GIT_ENV_SET = re.compile(rf"\b{_GIT_ENV}=|\b(?:export|declare|typeset|readonly|read|-v)\s+(?:-\S+\s+)*{_GIT_ENV}\b")
GIT_ENV_NAME = re.compile(rf"{_GIT_ENV}$")
# names that make a path agent config (skills, settings, hooks, instructions), never an agent path
AGENT_CONFIG = {".claude", "skills", "hooks", "settings.json", "settings.local.json", "CLAUDE.md", "CLAUDE.local.md", "AGENTS.md"}
# repo config keys that change who commits, how it's signed or which hooks run.
# only the owner's global config sets them for a state repo.
REPO_OVERRIDES = re.compile(r"^(?:user|author|committer|gpg|include|includeif)\.|^(?:commit\.gpgsign|core\.hookspath)$", re.I)
# the only commit flags an agent commit takes; -m and -F carry the message
COMMIT_MSG = ("-m", "--message", "-F", "--file")
COMMIT_QUIET = ("-q", "--quiet")
# commit flags 0002 §2.7 names as overrides, plus the history rewrites
COMMIT_OVERRIDES = ("--author", "--gpg-sign", "--no-gpg-sign", "--no-verify", "--amend", "--reset-author", "--date")
# git commands that make commits, beyond commit and commit-tree. a merge or pull
# that isn't --ff-only joins them. stash and notes make commits too, but off
# any branch, so they're fine outside a state repo.
COMMIT_MAKERS = {"cherry-pick", "revert", "am", "rebase", "fast-import", "filter-branch", "filter-repo", "subtree"}
# git commands that leave a state repo's history alone. any other one is a
# history write there, so one nobody listed fails closed. branch, tag, checkout,
# switch, stash, merge, pull, fetch, reflog, worktree and notes read or write by
# their flags (rewrites()).
STATE_READS = set("""
add annotate apply archive blame cat-file check-attr check-ignore check-mailmap cherry clone config
count-objects describe diff diff-files diff-index diff-tree difftool for-each-ref format-patch fsck grep help
init interpret-trailers log ls-files ls-remote ls-tree merge-base mv name-rev range-diff restore rev-list
rev-parse rm shortlog show show-branch show-ref status var verify-commit verify-tag version whatchanged
""".split())
BRANCH_WRITES = {"-m", "-M", "-c", "-C", "-f", "--force", "-u", "--set-upstream-to", "--unset-upstream", "--edit-description", "-t", "--track", "--no-track", "--create-reflog", "--move", "--copy"}

SHELLS = {"bash", "sh", "zsh", "fish", "dash", "ksh", "mksh", "ash"}
ROOT = {"sudo", "doas", "su", "pkexec", "run0"}
# wrapper -> (short options that take an argument, positional args before the command)
WRAPPERS = {
    "command": ("", 0), "builtin": ("", 0), "exec": ("a", 0), "nohup": ("", 0), "time": ("fo", 0),
    "noglob": ("", 0), "nice": ("n", 0), "ionice": ("cnp", 0), "stdbuf": ("ioe", 0), "timeout": ("sk", 1),
    "setsid": ("", 0), "chrt": ("", 1), "taskset": ("", 1), "xargs": ("IiLlnPdEsa", 0), "unbuffer": ("", 0),
    "npx": ("p", 0), "pnpx": ("", 0), "bunx": ("", 0),
}
PUBLISH = {
    "npm": {"publish"}, "pnpm": {"publish"}, "yarn": {"publish"}, "bun": {"publish"}, "cargo": {"publish"},
    "poetry": {"publish"}, "uv": {"publish"}, "twine": {"upload"}, "gem": {"push"}, "helm": {"push"},
    "docker": {"push"}, "podman": {"push"}, "buildah": {"push"}, "crane": {"push", "copy"}, "skopeo": {"copy"},
    "goreleaser": {"release", "publish"}, "vsce": {"publish"}, "ovsx": {"publish"},
}
# git builtins can't be shadowed by aliases, so only other subcommands need an alias lookup
GIT_BUILTINS = set("""
add am annotate apply archive bisect blame branch bundle cat-file check-ignore checkout cherry cherry-pick
clean clone commit commit-tree config count-objects credential describe diff diff-tree difftool fast-export fast-import
fetch filter-branch for-each-ref format-patch fsck gc grep hash-object help http-push init interpret-trailers
log ls-files ls-remote ls-tree maintenance merge merge-base mergetool mv name-rev notes prune pull push
range-diff rebase reflog remote repack replace request-pull reset restore rev-list rev-parse revert rm
send-pack shortlog show show-branch show-ref sparse-checkout stash status submodule switch symbolic-ref tag
update-index update-ref var verify-commit version whatchanged worktree
""".split())


class Blocked(Exception):
    pass


class Reform(Blocked):
    """a state repo commit in the wrong shape: the agent can fix it and retry."""


# the whole command, for the env check on commits
TEXT = ""


def short_flags(a):
    """letters of a short-option cluster like -fu, or '' for anything else."""
    return a[1:] if a.startswith("-") and not a.startswith("--") else ""


def resolve(cwd, path):
    if cwd is None or path == "-":
        return None
    path = re.sub(r"^~(?=/|$)", HOME, path).replace("${HOME}", HOME).replace("$HOME", HOME)
    if any(c in path for c in "$`*?"):
        return None
    return os.path.normpath(os.path.join(cwd, path))


def git(args, cwd, gopts):
    if cwd is None:
        raise Blocked("a git command in a directory the guard can't resolve")
    p = subprocess.run(["git", *gopts, *args], cwd=cwd, capture_output=True, text=True, timeout=10)
    return p.stdout.strip() if p.returncode == 0 else None


def substitutions(text):
    """bodies of $(...), <(...), >(...), balanced on parens."""
    out = []
    for m in re.finditer(r"[$<>]\(", text):
        depth, j = 1, m.end()
        while j < len(text) and depth:
            depth += {"(": 1, ")": -1}.get(text[j], 0)
            j += 1
        out.append(text[m.end():j - 1])
    return out


def split_heredocs(text):
    """drop heredoc bodies from the text; return bodies fed to a shell for checking."""
    lines, kept, fed, i = text.split("\n"), [], [], 0
    while i < len(lines):
        line = lines[i]
        kept.append(line)
        i += 1
        for m in HEREDOC.finditer(line):
            if m.start() > 0 and line[m.start() - 1] == "<":
                continue  # <<< here-string
            body = []
            while i < len(lines):
                cur = lines[i]
                i += 1
                if (cur.lstrip("\t") if m.group(1) else cur) == m.group(3):
                    break
                body.append(cur)
            if SHELL_FED.search(line):
                fed.append("\n".join(body))
    return "\n".join(kept), fed


def commands(text):
    """yield (words, redirects, separator before) per simple command."""
    lex = shlex.shlex(text, posix=True, punctuation_chars="();<>|&\n")
    lex.whitespace = " \t\r"
    lex.whitespace_split = True
    lex.commenters = ""
    toks = list(lex)
    words, redirs, sep, i = [], [], None, 0
    while i < len(toks):
        t = toks[i]
        if t and set(t) <= PUNCT:
            if "<" in t or ">" in t:
                redirs.append((t, toks[i + 1] if i + 1 < len(toks) else ""))
                i += 2
                continue
            yield words, redirs, sep
            words, redirs, sep = [], [], t
        else:
            words.append(t)
        i += 1
    yield words, redirs, sep


def check(text, cwd, depth=0):
    if depth > MAX_DEPTH:
        raise Blocked("a command nested too deep to check")
    for inner in re.findall(r"`([^`]*)`", text) + substitutions(text):
        check(inner, cwd, depth + 1)
    text, fed = split_heredocs(text)
    for body in fed:
        check(body, cwd, depth + 1)
    prev = None
    for words, redirs, sep in commands(text.replace("`", " ")):
        if words:
            cwd = check_simple(words, redirs, sep, prev, cwd, depth)
            prev = words
    return cwd


def unwrap(rest, argopts, npos):
    i = 0
    while i < len(rest) and rest[i].startswith("-") and rest[i] != "-":
        if rest[i] == "--":
            i += 1
            break
        if len(rest[i]) == 2 and rest[i][1] in argopts:
            i += 1
        i += 1
    return rest[i + npos:]


def shell_script(words):
    """the -c script of a shell invocation, or None (stdin or a script file)."""
    i = 1
    while i < len(words):
        w = words[i]
        if w in ("-c", "--command") or "c" in short_flags(w):
            return words[i + 1] if i + 1 < len(words) else ""
        if w.startswith("--command="):
            return w.split("=", 1)[1]
        if w in ("-o", "-O", "+o", "+O"):
            i += 1
        elif not w.startswith(("-", "+")):
            return None
        i += 1
    return None


def check_simple(words, redirs, sep, prev, cwd, depth):
    words = list(words)
    fed = False  # xargs adds arguments the guard never sees
    while True:
        while words and ASSIGN.match(words[0]):
            words.pop(0)
        if not words:
            return cwd
        prog = os.path.basename(words[0])
        if prog in ROOT:
            raise Blocked(f"{prog}: agents don't run commands as root")
        if prog in SHELLS:
            script = shell_script(words)
            if script is not None:
                check(script, cwd, depth + 1)
            elif prev and sep == "|" and os.path.basename(prev[0]) in ("echo", "printf"):
                check(" ".join(prev[1:]), cwd, depth + 1)
            for r, v in redirs:
                if r == "<<<":
                    check(v, cwd, depth + 1)
            return cwd
        if prog in ("eval", "watch"):
            check(" ".join(unwrap(words[1:], "n", 0) if prog == "watch" else words[1:]), cwd, depth + 1)
            return cwd
        if prog == "env":
            rest = words[1:]
            while rest and (rest[0].startswith("-") or ASSIGN.match(rest[0])):
                if rest[0] in ("-S", "--split-string") or rest[0].startswith("--split-string="):
                    check(" ".join(rest[1:]), cwd, depth + 1)
                    return cwd
                rest = rest[2:] if rest[0] in ("-u", "-C", "--unset", "--chdir") else rest[1:]
            words = rest
            continue
        if prog in WRAPPERS:
            fed = fed or prog == "xargs"
            words = unwrap(words[1:], *WRAPPERS[prog])
            continue
        if prog == "flock":
            rest = unwrap(words[1:], "wE", 0)[1:]
            if rest[:1] in (["-c"], ["--command"]):
                check(" ".join(rest[1:]), cwd, depth + 1)
                return cwd
            words = rest
            continue
        if prog == "direnv" and words[1:2] == ["exec"]:
            words = words[3:]
            continue
        if prog == "devbox" and words[1:2] == ["run"]:
            words = words[2:]
            continue
        if prog == "mise" and words[1:2] in (["exec"], ["x"]):
            words = words[words.index("--") + 1:] if "--" in words else words[2:]
            continue
        if prog in ("npm", "pnpm", "yarn", "bun") and words[1:2] in (["exec"], ["dlx"], ["x"]):
            words = unwrap(words[2:], "", 0)
            continue
        if prog == "nix" and ("-c" in words or "--command" in words):
            i = words.index("-c") if "-c" in words else words.index("--command")
            words = words[i + 1:]
            continue
        break
    args = words[1:]
    if prog in ("cd", "pushd"):
        return resolve(cwd, args[0] if args else "~")
    if prog == "git":
        check_git(args, cwd, depth, fed)
    elif prog == "gh":
        check_gh(args)
    check_publish(prog, args)
    return cwd


def check_git(args, cwd, depth, fed=False, overridden=False):
    if depth > MAX_DEPTH:
        raise Blocked("a git alias nested too deep to check")
    gopts, i = [], 0
    while i < len(args) and args[i].startswith("-"):
        a = args[i]
        if a == "-C":
            cwd = resolve(cwd, args[i + 1] if i + 1 < len(args) else "")
            i += 2
        elif a in ("-c", "--config-env") or a.startswith("--config-env="):
            kv = a.split("=", 1)[1] if "=" in a else (args[i + 1] if i + 1 < len(args) else "")
            if URL_KEY.match(kv.split("=", 1)[0]):
                raise Blocked("git -c overriding where a remote points")
            if kv.lower().startswith("alias."):
                raise Blocked("an inline git alias the guard can't follow")
            overridden = True
            i += 1 if "=" in a else 2
        elif a in ("--git-dir", "--work-tree", "--namespace"):
            gopts += args[i:i + 2]
            i += 2
        else:
            if a.startswith(("--git-dir=", "--work-tree=", "--namespace=")):
                gopts.append(a)
            i += 1
    if i >= len(args):
        return
    sub, rest = args[i], args[i + 1:]
    # every push is the user's: git push, git subtree push, git lfs push, and the plumbing under them
    if sub in ("push", "send-pack", "http-push") or (sub in ("subtree", "lfs") and "push" in rest):
        raise Blocked(f"git {sub}{' push' if sub in ('subtree', 'lfs') else ''}: pushes are the user's")
    if sub not in GIT_BUILTINS:
        alias = git(["config", "--get", f"alias.{sub}"], cwd, gopts)
        if alias and alias.startswith("!"):
            if fed or overridden:
                raise Blocked("a shell alias under xargs or git -c, which the guard can't follow")
            check(alias[1:] + " " + " ".join(map(shlex.quote, rest)), cwd, depth + 1)
            return
        if alias:
            check_git(shlex.split(alias) + rest, cwd, depth + 1, fed, overridden)
            return
        # an outside command (subtree, filter-repo, lfs) goes on to the history checks
    if sub == "branch" and any(a == "--delete" or set(short_flags(a)) & set("dD") for a in rest):
        raise Blocked("deleting a branch")
    elif sub == "update-ref" and ("-d" in rest or "--stdin" in rest):
        raise Blocked("deleting a ref")
    elif sub == "remote" and rest[:1] and rest[0] in ("add", "set-url", "rename"):
        raise Blocked(f"git remote {rest[0]}")
    elif sub == "worktree" and rest[:1] == ["remove"] and any(a == "--force" or "f" in short_flags(a) for a in rest[1:]):
        raise Blocked("git worktree remove --force")
    elif sub == "config":
        reading = {"--get", "--get-all", "--get-regexp", "--get-urlmatch", "--list", "-l", "get", "list"}
        writing = {"--unset", "--unset-all", "--add", "--replace-all", "unset", "set"}
        keys = [a for a in rest if not a.startswith("-") and a not in reading | writing]
        if keys and URL_KEY.match(keys[0]) and not reading & set(rest) and (len(keys) > 1 or writing & set(rest)):
            raise Blocked("changing where a git remote points")
    if sub in ("commit", "commit-tree"):
        check_commit(sub, rest, cwd, gopts, fed, overridden)
    elif rewrites(sub, rest):
        if gopts or GIT_ENV_SET.search(TEXT):
            raise Blocked(f"git {sub} with --git-dir, --work-tree or git env the guard can't place")
        repo = state_repo(load_config(), cwd)
        if repo:
            raise Blocked(f"git {sub} writes history in a state repo ({repo['path']}), which is the owner's (0002 §2.7)")
        if makes_commits(sub, rest):
            raise Blocked(f"git {sub} makes commits, and agents don't commit outside a state repo (0001 §2.3)")


def rewrites(sub, rest):
    """whether a git subcommand may write a state repo's history: commits,
    refs, tags or branches. anything off STATE_READS does."""
    pos = [a for a in rest if not a.startswith("-")]
    flags = {a.split("=", 1)[0] for a in rest if a.startswith("-")}
    if sub in ("merge", "pull"):
        return "--ff-only" not in flags or any(":" in p for p in pos)
    if sub == "tag":
        return bool(flags & {"-d", "--delete"}) or (bool(pos) and not flags & {"-l", "--list"})
    if sub == "branch":
        return bool(flags & BRANCH_WRITES) or (bool(pos) and not flags & {"-l", "--list"})
    if sub in ("checkout", "switch"):
        return bool(flags & {"-b", "-B", "-c", "-C", "--orphan"})
    if sub == "stash":
        return not pos or pos[0] not in ("list", "show")
    if sub == "fetch":
        return any(":" in p for p in pos)  # a refspec that names a local ref
    if sub in ("reflog", "notes"):
        return bool(pos) and pos[0] not in ("show", "list", "exists")
    if sub == "worktree":
        return not pos or pos[0] != "list"
    return sub not in STATE_READS


def makes_commits(sub, rest):
    """whether a git subcommand makes commits on a branch, which an agent does
    only with `git commit` in a state repo."""
    return sub in COMMIT_MAKERS or (sub in ("merge", "pull") and "--ff-only" not in rest)


def load_config(check_disk=False):
    """the state repos in claude-guard.json, as [{path, root, agent_paths}].

    a missing file means there are none. anything malformed blocks, and so does
    an agent path that is, or holds, agent config (0002 §2.7).
    """
    def bad(why):
        raise Blocked(f"claude-guard.json is broken ({why}), so commits and state repo history writes are blocked")

    try:
        with open(CONFIG) as f:
            data = json.load(f)
    except FileNotFoundError:
        return []
    except (OSError, ValueError) as e:
        bad(e)
    repos = data.get("state_repos") if isinstance(data, dict) else None
    if not isinstance(repos, list):
        bad("no state_repos list")
    out = []
    for r in repos:
        path, agent_paths = (r.get("path"), r.get("agent_paths")) if isinstance(r, dict) else (None, None)
        if not isinstance(path, str) or not isinstance(agent_paths, list) or not agent_paths:
            bad("each state repo needs a path and a non-empty agent_paths list")
        expanded = re.sub(r"^~(?=/|$)", HOME, path)
        if not os.path.isabs(expanded):
            bad(f"{path} isn't absolute")
        root = os.path.realpath(expanded)
        clean = []
        for a in agent_paths:
            n = os.path.normpath(a) if isinstance(a, str) and a else ""
            parts = set(n.split(os.sep))
            if n in ("", ".") or os.path.isabs(n) or parts & ({"..", ".git"} | AGENT_CONFIG) or any(c in n for c in "*?[]$`~"):
                bad(f"agent path {a!r} isn't a plain subdirectory, or it is agent config")
            if check_disk:
                for dirpath, dirs, files in os.walk(os.path.join(root, n)):
                    if ".git" in dirs or ".git" in files:
                        dirs[:] = []  # a nested repo's files, its AGENTS.md too, aren't this repo's to commit
                        continue
                    hit = AGENT_CONFIG & (set(dirs) | set(files))
                    if hit:
                        bad(f"{os.path.relpath(dirpath, root)} holds {', '.join(sorted(hit))}")
            clean.append(n)
        out.append({"path": path, "root": root, "agent_paths": clean})
    return out


def state_repo(repos, cwd):
    """the state repo whose toplevel cwd sits in, or None. a nested repo or a
    worktree has its own toplevel, so it never matches."""
    if not repos:
        return None
    top = git(["rev-parse", "--show-toplevel"], cwd, [])
    top = os.path.realpath(top) if top else None
    return next((r for r in repos if r["root"] == top), None)


def check_commit(sub, rest, cwd, gopts, fed, overridden):
    if sub == "commit-tree":
        raise Blocked("git commit-tree: an agent commit is `git commit -m <msg> -- <file>...` in a state repo")
    if overridden or gopts:
        raise Blocked("git -c, --git-dir or --work-tree on a commit (0002 §2.7 overrides)")
    if GIT_ENV_SET.search(TEXT) or any(GIT_ENV_NAME.match(k) for k in os.environ):
        raise Blocked("GIT_AUTHOR_*, GIT_COMMITTER_*, GIT_CONFIG_* or GIT_DIR-style env on a commit (0002 §2.7 overrides)")
    if fed:
        raise Blocked("a git commit fed by xargs, whose paths the guard can't see")
    repo = state_repo(load_config(check_disk=True), cwd)
    if repo is None:
        raise Blocked("a commit outside a state repo; agents don't commit here (0001 §2.3)")
    hits = repo_overrides(cwd)
    if hits:
        raise Blocked(f"the state repo's own git config sets {', '.join(hits)}, which can change who commits, how it's signed or which hooks run (0002 §2.7 overrides)")
    msg, paths, i = False, None, 0
    while i < len(rest):
        a = rest[i]
        if a == "--":
            paths = rest[i + 1:]
            break
        if a in COMMIT_MSG:
            if i + 1 >= len(rest):
                raise Reform(f"git commit {a} with no message")
            msg, i = True, i + 2
        elif a.startswith(("--message=", "--file=")) or (a[:2] in ("-m", "-F") and len(a) > 2):
            msg, i = True, i + 1
        elif a in COMMIT_QUIET:
            i += 1
        elif a.split("=", 1)[0] in COMMIT_OVERRIDES or set(short_flags(a)) & {"n", "S"}:
            raise Blocked(f"git commit {a} (0002 §2.7 overrides)")
        else:
            raise Reform(f"git commit {a}")
    if not msg:
        raise Reform("git commit with no -m")
    if not paths:
        raise Reform("git commit with no -- <file>..., which takes the whole index, another session's staging included")
    for p in paths:
        check_agent_path(repo, cwd, p)


def repo_overrides(cwd):
    """the REPO_OVERRIDES keys a repo's own config sets (local or worktree
    scope). a `git config` or an edit to .git/config lasts past the command
    that made it, so the guard reads the config, not the command."""
    out = git(["config", "--list", "--show-scope", "--name-only"], cwd, [])
    if out is None:
        raise Blocked("the guard couldn't read the state repo's git config")
    keys = (line.partition("\t") for line in out.splitlines())
    return sorted({k for scope, _, k in keys if scope in ("local", "worktree") and REPO_OVERRIDES.search(k)})


def check_agent_path(repo, cwd, p):
    if p.startswith(":") or any(c in p for c in "*?[]"):
        raise Reform(f"{p}: name each file, no globs or pathspec magic")
    path = resolve(cwd, p)
    if path is None:
        raise Reform(f"{p}: a path the guard can't resolve")
    real = os.path.join(os.path.realpath(os.path.dirname(path)), os.path.basename(path))
    rel = os.path.relpath(real, repo["root"])
    parts = rel.split(os.sep)
    if rel == "." or parts[0] == "..":
        raise Blocked(f"{p} is outside the state repo")
    if ".git" in parts or AGENT_CONFIG & set(parts):
        raise Blocked(f"{rel} is agent config or a .git dir, never an agent path (0001 §2.3)")
    if not any(rel == a or rel.startswith(a + os.sep) for a in repo["agent_paths"]):
        raise Blocked(f"{rel} isn't under an agent path ({', '.join(repo['agent_paths'])})")
    if os.path.isdir(real):
        raise Reform(f"{rel} is a directory: name each file")


def check_gh(args):
    pos = [a for a in args if not a.startswith("-")]
    sub, sub2 = (pos + ["", ""])[:2]
    if sub == "repo" and (sub2 in ("create", "fork", "rename", "delete") or (sub2 == "edit" and any(a.startswith("--visibility") for a in args))):
        raise Blocked(f"gh repo {sub2}")
    if sub == "release" and sub2 in ("create", "upload", "edit", "delete"):
        raise Blocked(f"gh release {sub2} (publishing)")
    if sub == "pr" and sub2 == "merge" and any(a == "-d" or a.startswith("--delete-branch") for a in args):
        raise Blocked("gh pr merge --delete-branch")
    if sub == "api":
        joined = " ".join(args)
        method = re.search(r"(?:-X|--method)[= ]?\s*(\w+)", joined)
        if method and method.group(1).upper() == "DELETE" and "git/refs" in joined:
            raise Blocked("deleting a branch through the GitHub API")
        if re.search(r"(?:^|\s)(?:-f|-F|--field|--raw-field)[= ]?\s*[\"']?(?:visibility|private)=", joined) or "deleteRef" in joined:
            raise Blocked("changing repo visibility or deleting refs through the GitHub API")


def check_publish(prog, args):
    if prog in PUBLISH and set(args) & PUBLISH[prog]:
        raise Blocked(f"{prog} publishing")
    if prog in ("docker", "podman", "buildah") and "--push" in args:
        raise Blocked(f"{prog} --push (publishing)")
    if prog == "goreleaser" and not [a for a in args if not a.startswith("-")]:
        raise Blocked("goreleaser (defaults to release)")


def main():
    global TEXT
    try:
        data = json.load(sys.stdin)
        cmd = TEXT = (data.get("tool_input") or {}).get("command") or ""
        if cmd.strip():
            check(cmd, data.get("cwd") or os.getcwd())
    except Reform as e:
        print(f"claude-guard blocked this: {e}. an agent commit in a state repo takes only `git commit -m <msg> -- <file>...`, each file under an agent path. fix it and retry, or hand the command to the user.", file=sys.stderr)
        return 2
    except Blocked as e:
        print(f"claude-guard blocked this: {e}. this is a hard rule; don't retry it another way. hand the command to the user.", file=sys.stderr)
        return 2
    except Exception as e:
        print(f"claude-guard couldn't check this command ({type(e).__name__}: {e}), so it's blocked. simplify it, or hand it to the user.", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
