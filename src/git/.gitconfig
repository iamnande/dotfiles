[user]
	name = nick anderson
	email = nick@morethq.com
	signingKey = ~/.ssh/id_ed25519_sk_rk_mhq-naomi-ssh

[alias]
	up = pull --rebase --autostash

[commit]
	gpgSign = true

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers

[include]
	path = ~/.gitconfig-local
[init]
	defaultBranch = main
