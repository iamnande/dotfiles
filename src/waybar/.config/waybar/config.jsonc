{
  "position": "top",
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["custom/hostname"],
  "modules-right": ["clock", "group/dashboard"],
  "hyprland/workspaces": {
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5, 6]
    }
  },
  "custom/hostname": {
    "exec": "uname -n",
    "interval": "once",
    "format": "  {}",
    "tooltip": false
  },
  "group/dashboard": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "children-class": "dashboard-drawer",
      "transition-left-to-right": false
    },
    "modules": ["custom/dashboard-toggle", "cpu", "memory", "disk", "network", "pulseaudio"]
  },
  "custom/dashboard-toggle": {
    "format": "󰕮",
    "tooltip-format": "Click for system dashboard"
  },
  "disk": {
    "format": "  {percentage_used}% used ({free} free)",
    "path": "/",
    "tooltip-format": "{used} used / {total} total on {path}\n{percentage_free}% free"
  },
  "cpu": {
    "format": "CPU {usage}%",
    "tooltip": false
  },
  "memory": {
    "format": "MEM {percentage}%",
    "tooltip-format": "{used:0.1f}GB / {total:0.1f}GB used"
  },
  "clock": {
    "format": "   {:%H:%M}",
    "format-alt": "   {:%Y-%m-%dT%H:%M:%S%Ez}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "actions": {
      "on-click": "mode"
    }
  },
  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "  {ifname}",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": "  Disconnected",
    "tooltip-format-wifi": "Signal Strength: {signalStrength}%",
    "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}"
  },
  "pulseaudio": {
      "format": "VOL {volume}%",
      "format-muted": "VOL muted",
      "on-click": "pavucontrol"
  }
}
